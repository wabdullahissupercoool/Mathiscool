import random

def generate_10000_games():
    genres = ["RPG", "Platformer", "Racing", "Puzzle", "Shooter", "Strategy", "Fighting", "Sandbox", "Survival"]
    adjectives = ["Epic", "Super", "Cyber", "Retro", "Cosmic", "Shadow", "Infinite", "Mega", "Neon", "Quantum"]
    nouns = ["Quest", "Runner", "Striker", "World", "Legends", "Breaker", "Odyssey", "Championship", "Chronicles"]
    
    print("--- GENERATING 10,000 UNIQUE GAMES ---")
    # Using a list comprehension for fast generation of 10,000 items
    games = [
        f"Game #{i:05d} | Title: {random.choice(adjectives)} {random.choice(nouns)} {random.randint(1, 10):<2} | Genre: {random.choice(genres):<12} | Rating: ⭐ {round(random.uniform(3.5, 5.0), 1)}"
        for i in range(1, 10001)
    ]
    
    # Print the first 50 as a sample, and the final 10 to show completion
    for game in games[:50]:
        print(game)
    print("...\n[Truncated 9,940 games for performance]\n...")
    for game in games[-10:]:
        print(game)

generate_10000_games()
